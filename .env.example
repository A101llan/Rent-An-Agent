# Environment
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://agenthub:agenthub@postgres:5432/agenthub
DATABASE_URL_SYNC=postgresql://agenthub:agenthub@postgres:5432/agenthub

# Redis
REDIS_URL=redis://redis:6379/0

# JWT & Security
JWT_SECRET=change-me-in-production-use-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=change-me-32-byte-key-for-secrets!!

# CORS
CORS_ORIGINS=http://localhost:3000

# Object Storage (MinIO)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=agenthub
STORAGE_REGION=us-east-1

# Runtime Manager
RUNTIME_MANAGER_URL=http://runtime-manager:8001
RUNTIME_PROVIDER=docker
AGENT_IMAGE=agenthub-demo-agent:latest
DOCKER_NETWORK=agenthub-agents
DOCKER_HOST=unix:///var/run/docker.sock

# OpenTelemetry
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agenthub-api

# AI Models (optional for demo agents)
OPENAI_API_KEY=

# Platform
PLATFORM_FEE_BPS=2000
DEFAULT_CURRENCY=USD

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000

# Development seed credentials (DO NOT USE IN PRODUCTION)
# Admin: admin@agenthub.dev / Admin123!
# Developer: dev@agenthub.dev / Dev123!
# Customer: customer@agenthub.dev / Customer123!
# Local Ollama (optional — Meeting Notes Agent falls back to canned JSON if unavailable)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b
